# Copy to .env.production. Use distinct, URL-safe alphanumeric credentials.
# This file is for a fresh production volume; existing data needs a migration plan.
# Pin a published v* release tag. latest follows the last published release.
IMAGE_TAG=

# Lowercase DNS hostnames pointed at this VPS. Use three distinct names.
TRACKER_DOMAIN=
POSTBACK_DOMAIN=
APP_DOMAIN=

MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=

CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

AUTH_ADMIN_EMAIL=
AUTH_JWT_SECRET=
AUTH_EMAIL_FROM=
AUTH_RESEND_API_KEY=

# Must equal the reserved address of Nginx in /opt/infra/.env, with /32.
NGINX_PROXY_CIDR=172.30.240.10/32
