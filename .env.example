API_SERVICE_ADDR=:8070
TRAFFIC_SERVICE_ADDR=:8080
POSTBACK_SERVICE_ADDR=:8081

MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=traffoflex

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=traffoflex
CLICKHOUSE_DATABASE=traffoflex
# Include database=traffoflex so unqualified report queries use the MVP schema.
CLICKHOUSE_HTTP_URL=http://default:traffoflex@clickhouse:8123?database=traffoflex

EVENT_BROKERS=redpanda-0:9092,redpanda-1:9092,redpanda-2:9092
EVENT_BATCH_SIZE=100
EVENT_BATCH_TIMEOUT_MS=10
EVENT_WRITE_TIMEOUT_MS=3000
EVENT_WRITE_MAX_ATTEMPTS=3
EVENT_WRITE_RETRY_BACKOFF_MS=100
EVENT_WRITE_FAILURE_POLICY=fail_open
EVENT_QUEUE_SIZE=10000
EVENT_DRAIN_TIMEOUT_MS=8000
CLICK_WAL_PATH=/data/click-wal
CLICK_WAL_MAX_MB=2048
CLICK_WAL_SEGMENT_MB=16
CLICK_WAL_RETRY_MS=1000
DESTINATION_HEALTHCHECK_TIMEOUT_MS=5000
DESTINATION_HEALTHCHECK_INTERVAL_MS=60000
DESTINATION_HEALTHCHECK_FAILURES=3
DESTINATION_HEALTHCHECK_RECOVERY=2
DESTINATION_HEALTHCHECK_PARALLELISM=4
DESTINATION_CAP_CACHE_TTL_MS=10000
BLOOM_EXPECTED_KEYS_PER_BUCKET=50000
BLOOM_FALSE_POSITIVE_RATE=0.001
BLOOM_MAX_MEMORY_MB=512
BLOOM_BUCKET_COUNT=24
BLOOM_SNAPSHOT_PATH=/data/bloom/snapshot.gob
BLOOM_SNAPSHOT_INTERVAL_MS=30000
ROUTING_SNAPSHOT_PATH=/data/cache/campaigns.json
CAMPAIGN_CACHE_REFRESH_INTERVAL_MS=30000
CLICK_EVENTS_TOPIC=traffoflex.click_events
CONVERSION_EVENTS_TOPIC=traffoflex.conversion_events
ATTRIBUTED_CONVERSION_EVENTS_TOPIC=traffoflex.attributed_conversion_events
POSTBACK_LOG_EVENTS_TOPIC=traffoflex.postback_log_events
TRAFFICBACK_EVENTS_TOPIC=traffoflex.trafficback_events
DESTINATION_HEALTH_EVENTS_TOPIC=traffoflex.destination_health_events

TRUSTED_PROXY_CIDRS=
TRUSTED_IP_HEADERS=X-Forwarded-For,X-Real-IP

TRAFFIC_SERVICE_URL=http://traffic-service:8080
POSTBACK_SERVICE_URL=http://postback-service:8081
ADMIN_FRONTEND_ORIGIN=http://localhost:5173
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_JWT_SECRET=change-me-local-dev-secret
AUTH_OTP_TTL_SECONDS=10
AUTH_OTP_RATE_LIMIT_MINUTES=1
AUTH_SESSION_TTL_HOURS=24
AUTH_ENV=local
AUTH_DEV_RETURN_OTP=true
AUTH_EMAIL_FROM=noreply@example.com
AUTH_RESEND_API_KEY=
AUTH_RESEND_API_URL=https://api.resend.com/emails
AUTH_RESEND_MAX_ATTEMPTS=3
AUTH_RESEND_RETRY_BACKOFF_MS=500
VITE_API_BASE_URL=http://localhost:8070
