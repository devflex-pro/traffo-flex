# Enable only after Certbot has issued /etc/letsencrypt/live/traffoflex/.
# The upstream names are unique aliases on the shared proxy network.
server {
    listen 80;
    server_name __TRACKER_DOMAIN__ __POSTBACK_DOMAIN__ __APP_DOMAIN__;
    access_log /dev/stdout postback_safe;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __TRACKER_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/traffoflex/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/traffoflex/privkey.pem;

    location ^~ /internal/ { return 404; }
    location = /healthz { return 404; }
    location = /readyz { return 404; }

    location / {
        set $traffic_upstream http://traffoflex-traffic:8080;
        proxy_pass $traffic_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    server_name __POSTBACK_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/traffoflex/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/traffoflex/privkey.pem;
    # Postback secrets can arrive in query strings. Keep request lines out of access logs.
    access_log /dev/stdout postback_safe;

    location ^~ /internal/ { return 404; }
    location = /healthz { return 404; }
    location = /readyz { return 404; }

    location / {
        set $postback_upstream http://traffoflex-postback:8081;
        proxy_pass $postback_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name __APP_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/traffoflex/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/traffoflex/privkey.pem;

    location /api/ {
        set $api_upstream http://traffoflex-api:8070;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $frontend_upstream http://traffoflex-frontend:8080;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
